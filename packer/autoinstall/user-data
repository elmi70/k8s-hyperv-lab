#cloud-config
autoinstall:
  version: 1
  locale: en_US.UTF-8
  keyboard:
    layout: us
  identity:
    hostname: ubuntu2604
    username: vagrant
    # Lab bootstrap credential only (password: vagrant). Change before using outside this disposable lab.
    # Regenerate with: openssl passwd -6 -salt 'rounds=4096$VagrantLab' 'vagrant'
    password: "$6$rounds=4096$VagrantLab$WUXY9Am5NSzDYpswsjVdRjQPlaEsucDQDCEm3AETxsR3kJqVow84h1re5lAiVWcxauQ4ysxw/jKPmhnNJjet90"
  ssh:
    install-server: true
    allow-pw: true
    # Vagrant's well-known insecure public keys (hashicorp/vagrant keys/vagrant.pub).
    # The Vagrantfile sets insert_key = false, so Vagrant keeps using these keys.
    authorized-keys:
      - "ssh-rsa  vagrant insecure public key"
      - "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIN1YdxBpNlzxDqfJyw/QKow1F+wvG9hXGoqiysfJOn5Y vagrant insecure public key"
  storage:
    layout:
      name: direct
  packages:
    - ca-certificates
    - curl
    - openssh-server
  late-commands:
    - curtin in-target --target=/target -- usermod -aG sudo vagrant
    - curtin in-target --target=/target -- sh -c "echo 'vagrant ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/99-vagrant"
    - curtin in-target --target=/target -- chmod 0440 /etc/sudoers.d/99-vagrant
    - curtin in-target --target=/target -- systemctl enable ssh
  # No `shutdown:` key: the installer reboots into the installed system so Packer can connect
  # over SSH and run its provisioners. Packer powers the VM off itself (shutdown_command).
