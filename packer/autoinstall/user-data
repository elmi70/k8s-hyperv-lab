#cloud-config
autoinstall:
  version: 1
  locale: en_US.UTF-8
  keyboard:
    layout: us
  identity:
    hostname: ubuntu2604
    username: vagrant
    # Lab bootstrap credential only. Change before using outside this disposable lab.
    password: "$6$rounds=4096$VagrantLab$9Ue5TvoxcxbMBQPHk6TmwvTuxuMInu8YJ5KVM1eaTeT2WfCUWq0hwLhxo80vqIYEJhzTqUuT0C/t1jJAz.NE/"
  ssh:
    install-server: true
    allow-pw: true
  storage:
    layout:
      name: direct
  packages:
    - ca-certificates
    - curl
    - openssh-server
  late-commands:
    - curtin in-target --target=/target -- usermod -aG sudo vagrant
    - curtin in-target --target=/target -- sh -c "echo 'vagrant ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/99-vagrant"
    - curtin in-target --target=/target -- chmod 0440 /etc/sudoers.d/99-vagrant
    - curtin in-target --target=/target -- systemctl enable ssh
  shutdown: poweroff
